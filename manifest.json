{
  "manifest_version": 3,
  "name": "ChatGPT Images Quick Download",
  "short_name": "CG Image DL",
  "version": "0.2.0",
  "description": "Adds a small transparent download button on ChatGPT Images gallery tiles so each image can be saved in one click.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "downloads"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://*.oaistatic.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/imageTargets.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT Images Quick Download",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
